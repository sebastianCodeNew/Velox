// ============================================================================
// Velox Reference Model: IFM K2-Horizon-3.7B Foundation Model Architecture
// File: examples/k2_horizon_3_7b.vlx
// Target Hardware: NVIDIA GeForce RTX 3050 Laptop (4096 MiB GDDR6 VRAM, sm_86)
// ============================================================================

target hardware {
    device: "nvidia_rtx_3050_laptop";
    vram_capacity: 4096 * MiB;
    compute_capability: 8.6;
    safety_factor: 0.95;
}

model K2_Horizon_3_7B<
    const B_MAX: usize = 1,
    const S_MAX: usize = 524288,
    const VOCAB: usize = 250624,
    const HIDDEN_DIM: usize = 2560,
    const INTERMEDIATE_DIM: usize = 10240,
    const NUM_LAYERS: usize = 36,
    const NUM_HEADS: usize = 32,
    const NUM_KV_HEADS: usize = 8,
    const HEAD_DIM: usize = 128,
    const ROPE_THETA: usize = 10000000
> {
    // Model Parameter Weights (INT4 Quantized for 4GB VRAM Feasibility)
    @vram_immutable weight w_embed: Tensor<[VOCAB, HIDDEN_DIM], int4> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.embed_tokens.weight");

    @vram_immutable weight w_q: Tensor<[NUM_LAYERS, HIDDEN_DIM, 4096], int4> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.layers.self_attn.q_proj.weight");
    @vram_immutable weight w_k: Tensor<[NUM_LAYERS, HIDDEN_DIM, 1024], int4> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.layers.self_attn.k_proj.weight");
    @vram_immutable weight w_v: Tensor<[NUM_LAYERS, HIDDEN_DIM, 1024], int4> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.layers.self_attn.v_proj.weight");
    @vram_immutable weight w_o: Tensor<[NUM_LAYERS, 4096, HIDDEN_DIM], int4> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.layers.self_attn.o_proj.weight");

    @vram_immutable weight w_gate: Tensor<[NUM_LAYERS, HIDDEN_DIM, INTERMEDIATE_DIM], int4> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.layers.mlp.gate_proj.weight");
    @vram_immutable weight w_up: Tensor<[NUM_LAYERS, HIDDEN_DIM, INTERMEDIATE_DIM], int4> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.layers.mlp.up_proj.weight");
    @vram_immutable weight w_down: Tensor<[NUM_LAYERS, INTERMEDIATE_DIM, HIDDEN_DIM], int4> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.layers.mlp.down_proj.weight");

    @vram_immutable weight w_input_norm: Tensor<[NUM_LAYERS, HIDDEN_DIM], f32> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.layers.input_layernorm.weight");
    @vram_immutable weight w_post_norm: Tensor<[NUM_LAYERS, HIDDEN_DIM], f32> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.layers.post_attention_layernorm.weight");
    @vram_immutable weight w_norm: Tensor<[HIDDEN_DIM], f32> = 
        safetensors("k2-horizon-3.7b.safetensors", "model.norm.weight");
    @vram_immutable weight w_lm_head: Tensor<[HIDDEN_DIM, VOCAB], int4> = 
        safetensors("k2-horizon-3.7b.safetensors", "lm_head.weight");

    // Native Paged Key-Value Cache Pool (Host RAM Pinned Tier for 512K context)
    @host_pinned let mut kv_cache: PagedKVCache<NUM_LAYERS, NUM_KV_HEADS, HEAD_DIM, 16, f16>;

    // Execution Pipeline: Prefill Phase (Full-prompt causal self-attention)
    scope prefill<const B: usize, const S: usize>(
        tokens: Tensor<[B, S], u32>
    ) -> Tensor<[B, 1], u32> {
        let mut h = embed(tokens, w_embed);

        for l in 0..NUM_LAYERS {
            let norm_x = rmsnorm(h, w_input_norm[l], eps = 1e-5);
            let (q, k, v) = qkv_proj(norm_x, w_q[l], w_k[l], w_v[l]);
            let q_rot = rope(q, 0);
            let k_rot = rope(k, 0);

            let attn_context = gqa_attention(q_rot, k_rot, v, &mut kv_cache, l);
            h += attn_context @ w_o[l];

            let mlp_norm = rmsnorm(h, w_post_norm[l], eps = 1e-5);
            h += swiglu(mlp_norm, w_gate[l], w_up[l], w_down[l]);
        }

        let out_norm = rmsnorm(h, w_norm, eps = 1e-5);
        let final_logits = lm_head(out_norm[:, S - 1, :], w_lm_head);
        return sample_argmax(final_logits);
    }

    // Execution Pipeline: Decode Phase (Sub-80us latency-bounded autoregression)
    scope decode<const B: usize>(
        next_token: Tensor<[B, 1], u32>,
        step: usize
    ) -> Tensor<[B, 1], u32> {
        let mut h = embed(next_token, w_embed);

        for l in 0..NUM_LAYERS {
            let norm_x = rmsnorm(h, w_input_norm[l], eps = 1e-5);
            let (q, k, v) = qkv_proj(norm_x, w_q[l], w_k[l], w_v[l]);
            let q_rot = rope(q, step);
            let k_rot = rope(k, step);

            let mut slot = kv_cache.borrow_slot_mut(0, step);
            slot.write(l, k_rot, v);

            let attn_context = gqa_attention(q_rot, &kv_cache, l);
            h += attn_context @ w_o[l];

            let mlp_norm = rmsnorm(h, w_post_norm[l], eps = 1e-5);
            h += swiglu(mlp_norm, w_gate[l], w_up[l], w_down[l]);
        }

        let out_norm = rmsnorm(h, w_norm, eps = 1e-5);
        let final_logits = lm_head(out_norm, w_lm_head);
        return sample_argmax(final_logits);
    }
}
